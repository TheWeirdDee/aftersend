# Copy to .env.local for local development. Never commit real values.
#
# Write every comment on its own line, never after a value. Next.js drops a trailing "# note", but Vercel keeps it as
# part of the value (NAME=30000   # note is stored as the whole string), which once started production with NaN settings.
# `npm run check:env -- --file .env.local` and `npm run env:sync` both refuse a file that does this.

# Public origin used for share links, e.g. https://aftersend.vercel.app
APP_URL=

# Hosted Postgres (e.g. Supabase). Leave empty locally to use embedded PGlite in .data/pglite.
# DATABASE_URL: the transaction pooler (port 6543). A password with special characters must be percent-encoded;
# `npm run db:set-password` does that for you.
DATABASE_URL=
# MIGRATION_DATABASE_URL: the session pooler (port 5432) or direct URI, used only by npm run db:migrate.
MIGRATION_DATABASE_URL=
# Connections per server instance; keep small behind a pooler.
DATABASE_POOL_MAX=3

# Object storage. "local" writes to LOCAL_STORAGE_DIR. Deployed: "supabase" (REST API, private bucket)
# or "s3" (any S3-compatible store).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/objects
OBJECT_STORAGE_BUCKET=
# Ceiling for one storage request, in milliseconds (500 to 30000).
STORAGE_TIMEOUT_MS=10000
# e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Speech. "assemblyai" is the real integration. "test" is a labelled tone generator for automated tests
# only and additionally requires AFTERSEND_ALLOW_TEST_PROVIDER=1.
SPEECH_PROVIDER=assemblyai
AFTERSEND_ALLOW_TEST_PROVIDER=0
# Server-only.
ASSEMBLYAI_API_KEY=
# tts.eu.assemblyai.com keeps processing in the EU.
ASSEMBLYAI_TTS_ENDPOINT=wss://tts.us.assemblyai.com/v1/ws
# Optional label; the server reports the model it used.
ASSEMBLYAI_TTS_MODEL=
# Comma-separated voice ids.
ASSEMBLYAI_TTS_VOICES=aai-jane,aai-kyla
# One synthesis attempt, in milliseconds.
ASSEMBLYAI_TTS_TIMEOUT_MS=30000
# A whole generate request, in milliseconds; the route allows 60 s.
SYNTHESIS_DEADLINE_MS=50000

# Email sign-in. Codes are sent with Resend (https://resend.com). AUTH_SECRET signs the codes and is required in production.
# "file" writes messages to EMAIL_OUTBOX_DIR for automated tests only and needs AFTERSEND_ALLOW_TEST_EMAIL=1.
# Server-only; generate with: openssl rand -base64 32
AUTH_SECRET=
EMAIL_DRIVER=resend
AFTERSEND_ALLOW_TEST_EMAIL=0
# Server-only.
RESEND_API_KEY=
# e.g. AfterSend <login@your-verified-domain.com>
EMAIL_FROM=
EMAIL_OUTBOX_DIR=.data/outbox

# Abuse limits
AUTH_REQUESTS_PER_IP_PER_HOUR=20
# All sign-in emails per UTC day; the email account quota is shared with other apps.
AUTH_EMAILS_PER_DAY=60
AUTH_VERIFY_PER_IP_PER_HOUR=30
# Spoken previews per hour: the editor prepares one after each pause in typing. Guests (no email yet) get the lower limit.
SYNTHESIS_LIMIT_PER_HOUR=60
GUEST_SYNTHESIS_LIMIT_PER_HOUR=20
DEMO_WORKSPACES_PER_IP_PER_HOUR=10

# Protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
