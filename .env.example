# Copy to .env.local for local development. Never commit real values.

# Public origin used for share links, e.g. https://aftersend.vercel.app
APP_URL=

# Hosted Postgres (e.g. Supabase). Leave empty locally to use embedded PGlite in .data/pglite.
DATABASE_URL=

# Object storage. "local" writes to LOCAL_STORAGE_DIR; use "s3" (e.g. Supabase Storage S3) when deployed.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/objects
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Speech. "assemblyai" is the real integration. "test" is a labelled tone generator for automated tests
# only and additionally requires AFTERSEND_ALLOW_TEST_PROVIDER=1.
SPEECH_PROVIDER=assemblyai
AFTERSEND_ALLOW_TEST_PROVIDER=0
ASSEMBLYAI_API_KEY=                 # server-only
ASSEMBLYAI_TTS_ENDPOINT=wss://streaming-tts.assemblyai.com/v1/ws
ASSEMBLYAI_TTS_MODEL=               # fill from verified organiser docs
ASSEMBLYAI_TTS_VOICES=              # comma-separated, verified voice ids only
ASSEMBLYAI_TTS_TIMEOUT_MS=45000

# Abuse limits
SYNTHESIS_LIMIT_PER_HOUR=30
DEMO_WORKSPACES_PER_IP_PER_HOUR=10

# Protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
